page {
  background: #0f0f1a;
  height: 100%;
}

.set-page {
  min-height: 100vh;
  padding: 32rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 32rpx);
  box-sizing: border-box;
  background: linear-gradient(180deg, #1a1030 0%, #0f0f1a 100%);
}

/* Section */
.section {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.row-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

.section-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 12rpx;
}

/* Type cards */
.type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1.5rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s;
}

.type-card-active {
  border-color: rgba(139, 92, 246, 0.4);
  background: rgba(139, 92, 246, 0.06);
}

.type-card:active {
  opacity: 0.7;
}

.type-card-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.type-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.type-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
}

.type-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.type-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 12rpx;
}

/* Tips */
.tips-section {
  margin-top: 48rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
}

.tips-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  display: block;
  margin-bottom: 16rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  line-height: 1.8;
}

/* Setup mode header */
.setup-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.setup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.setup-step-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #8B5CF6;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 44rpx;
}

.step-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* Canvas */
.gesture-canvas-wrap {
  width: 600rpx;
  height: 600rpx;
  margin: 24rpx auto 0;
}

.gesture-canvas {
  width: 100%;
  height: 100%;
}

/* Tip */
.lock-tip {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  min-height: 56rpx;
  line-height: 56rpx;
  margin-top: 16rpx;
}

.lock-tip.tip-error {
  color: #EF4444;
}

.lock-tip.tip-success {
  color: #10B981;
}

/* PIN */
.pin-dots {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  margin-top: 48rpx;
  margin-bottom: 8rpx;
}

.pin-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  transition: all 0.15s;
}

.pin-dot.filled {
  background: #8B5CF6;
  border-color: #8B5CF6;
  box-shadow: 0 0 12rpx rgba(139, 92, 246, 0.6);
}

.pin-dot.dot-error {
  border-color: #EF4444;
}

.pin-dot.dot-error.filled {
  background: #EF4444;
  border-color: #EF4444;
  box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.6);
}

.pin-dot.dot-success.filled {
  background: #10B981;
  border-color: #10B981;
}

.pin-pad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-top: 48rpx;
  width: 600rpx;
  margin-left: auto;
  margin-right: auto;
}

.pin-key {
  height: 120rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 500;
  color: #ffffff;
  transition: background 0.15s;
}

.pin-key:active {
  background: rgba(139, 92, 246, 0.25);
}

.pin-key-empty {
  background: transparent;
  pointer-events: none;
}

.pin-key-del {
  background: rgba(255, 255, 255, 0.04);
}
