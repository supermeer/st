/* pages/star-yao-ji/index.wxss */
page {
  background: #0a0414;
  background: linear-gradient(180deg, #1a0f3a 0%, #0a0414 40%, #050008 100%);
  color: #fff;
  height: 100%;
  overflow: hidden;
}

.creator-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 星空背景（金色光点） ===== */
.starry-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.star-dot {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, #ffd54a 0%, rgba(255, 213, 74, 0.4) 50%, transparent 100%);
  box-shadow: 0 0 8rpx rgba(255, 213, 74, 0.8);
}

.star-dot::before,
.star-dot::after {
  content: '';
  position: absolute;
  background: rgba(255, 213, 74, 0.7);
  border-radius: 1rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.star-dot::before {
  width: 100%;
  height: 1rpx;
}

.star-dot::after {
  width: 1rpx;
  height: 100%;
}

.star-dot-1 { top: 4%; left: 8%; width: 6rpx; height: 6rpx; }
.star-dot-2 { top: 8%; left: 32%; width: 4rpx; height: 4rpx; }
.star-dot-3 { top: 6%; left: 72%; width: 8rpx; height: 8rpx; }
.star-dot-4 { top: 14%; left: 88%; width: 5rpx; height: 5rpx; }
.star-dot-5 { top: 20%; left: 18%; width: 4rpx; height: 4rpx; }
.star-dot-6 { top: 26%; left: 52%; width: 6rpx; height: 6rpx; }
.star-dot-7 { top: 32%; left: 92%; width: 5rpx; height: 5rpx; }
.star-dot-8 { top: 38%; left: 6%; width: 7rpx; height: 7rpx; }
.star-dot-9 { top: 44%; left: 78%; width: 4rpx; height: 4rpx; }
.star-dot-10 { top: 50%; left: 24%; width: 5rpx; height: 5rpx; }
.star-dot-11 { top: 56%; left: 62%; width: 6rpx; height: 6rpx; }
.star-dot-12 { top: 62%; left: 12%; width: 4rpx; height: 4rpx; }
.star-dot-13 { top: 68%; left: 88%; width: 7rpx; height: 7rpx; }
.star-dot-14 { top: 72%; left: 38%; width: 5rpx; height: 5rpx; }
.star-dot-15 { top: 78%; left: 70%; width: 4rpx; height: 4rpx; }
.star-dot-16 { top: 84%; left: 16%; width: 6rpx; height: 6rpx; }
.star-dot-17 { top: 88%; left: 50%; width: 5rpx; height: 5rpx; }
.star-dot-18 { top: 92%; left: 84%; width: 4rpx; height: 4rpx; }
.star-dot-19 { top: 12%; left: 48%; width: 3rpx; height: 3rpx; }
.star-dot-20 { top: 30%; left: 36%; width: 3rpx; height: 3rpx; }

.creator-nav {
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

/* 固定头部：用户卡 + 公告 + 三栏统计 */
.creator-header {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 0 32rpx;
}

/* 可滚动区域 */
.creator-scroll {
  position: relative;
  z-index: 1;
  flex: 1 1 auto;
  width: 100%;
  box-sizing: border-box;
  padding: 0 32rpx 32rpx;
}

/* ===== 用户信息卡 ===== */
.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 24rpx;
}

.user-card-avatar-wrapper {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.user-card-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #a78bfa 0%, #6c5ce7 100%) border-box;
  position: relative;
  z-index: 1;
}

.user-card-avatar-wrapper::before {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  z-index: 0;
  box-shadow: 0 0 20rpx rgba(167, 139, 250, 0.5);
}

.user-card-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.user-card-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.3;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-card-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 6rpx 16rpx;
  background: linear-gradient(90deg, rgba(167, 139, 250, 0.25) 0%, rgba(108, 92, 231, 0.25) 100%);
  border: 1rpx solid rgba(167, 139, 250, 0.5);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #d6c9ff;
  max-width: 100%;
}

.user-card-badge-icon {
  margin-right: 6rpx;
  color: #ffd54a;
}

/* ===== 公告行 ===== */
.announcement-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.announcement-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.announcement-text {
  flex: 1;
  font-size: 26rpx;
  color: #ddd;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announcement-arr {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 三栏统计卡 ===== */
.stat-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  position: relative;
  flex: 1;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.3s;
}

.stat-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.stat-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: rgba(255, 255, 255, 0.06);
}

.stat-card--role .stat-card-bg {
  background-image: linear-gradient(135deg, rgba(167, 139, 250, 0.85) 0%, rgba(108, 92, 231, 0.85) 100%);
}

.stat-card--group .stat-card-bg {
  background-image: linear-gradient(135deg, rgba(139, 139, 250, 0.85) 0%, rgba(91, 0, 255, 0.85) 100%);
}

.stat-card--income .stat-card-bg {
  background-image: linear-gradient(135deg, rgba(255, 213, 74, 0.85) 0%, rgba(255, 138, 61, 0.85) 100%);
}

.stat-card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #fff;
}

.stat-card-num {
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1.1;
  display: flex;
  align-items: baseline;
}

.stat-card-num--small {
  font-size: 28rpx;
  font-weight: normal;
}

.stat-card-unit {
  font-size: 24rpx;
  font-weight: normal;
  margin-left: 6rpx;
}

.stat-card-income {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-left: 6rpx;
}

.stat-card-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 4rpx;
}

.stat-card-btn {
  align-self: flex-start;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 22rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

/* ===== 通用 section 标题 ===== */
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.section-title-bar {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ffd54a 0%, #ff8a3d 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ===== 我的收益 ===== */
.income-section {
  margin-bottom: 36rpx;
}

.income-grid {
  display: flex;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.income-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.income-item-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffd54a;
  line-height: 1.2;
}

.income-item-label {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  text-align: center;
}

/* ===== 我的战绩 ===== */
.achievement-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

/* 战绩汇总卡（紫色渐变） */
.achievement-summary {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.25) 0%, rgba(108, 92, 231, 0.25) 100%);
  border: 1rpx solid rgba(167, 139, 250, 0.35);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.achievement-summary-row {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.achievement-summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 16rpx;
}

.achievement-summary-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  display: flex;
  align-items: baseline;
  line-height: 1.2;
}

.achievement-summary-unit {
  font-size: 24rpx;
  font-weight: normal;
  margin-left: 6rpx;
}

.achievement-summary-percent {
  color: #ffd54a;
  font-size: 40rpx;
  margin: 0 4rpx;
}

.achievement-summary-label {
  font-size: 24rpx;
  color: #d6c9ff;
  margin-top: 8rpx;
  text-align: center;
}

/* 智能体战绩列表 */
.role-achievement-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-achievement-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s;
}

.role-achievement-item:active {
  transform: scale(0.98);
  opacity: 0.85;
}

.role-achievement-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background-color: rgba(255, 255, 255, 0.05);
}

.role-achievement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.role-achievement-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-achievement-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.role-achievement-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: rgba(255, 213, 74, 0.15);
  border: 1rpx solid rgba(255, 213, 74, 0.3);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #ffd54a;
}

.role-achievement-tag-tick {
  color: #ffd54a;
  font-weight: bold;
  margin-right: 4rpx;
}

.role-achievement-arr {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 通用状态 ===== */
.empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: #999;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #a78bfa 0%, #6c5ce7 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* ===== 底部占位 ===== */
.bottom-placeholder {
  height: 60rpx;
  width: 100%;
  flex-shrink: 0;
}