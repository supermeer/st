<view class="rank-page">
  <custom-nav
    class="custom-nav"
    show-back="{{true}}"
    show-left-logo="{{false}}"
    show-home="{{false}}"
    transparent="{{true}}"
  />

  <view class="rank-header">
    <view class="left-block">
      <view class="header-title">排行榜</view>
      <view class="date">截止 {{dateText}}</view>
    </view>  
    <t-image class="rank-image" src="/static/discover/rank.png" mode="aspectFit" />
  </view>

  <view class="tabs">
    <view class="tab {{activeTab==='hot'?'active':''}}" data-type="hot" bindtap="onTabChange">近期人气崽</view>
    <view class="tab {{activeTab==='wow'?'active':''}}" data-type="wow" bindtap="onTabChange">隐藏宝藏崽</view>
    <view class="tab {{activeTab==='new'?'active':''}}" data-type="new" bindtap="onTabChange">新崽集合站</view>
  </view>

  <scroll-view class="content" scroll-y style="height: calc(100vh - {{pageInfo.navHeight}}px - 180rpx);" bindscrolltolower="onLoadMore">

    <!-- 人气：纵向榜单样式（带TOP徽标） -->
    <view wx:if="{{activeTab==='hot'}}" class="list-hot">
      <view class="hot-item" wx:for="{{list}}" wx:key="id" bindtap="onRoleClick" data-id="{{item.characterId}}">
        <image class="cover" src="{{item.url}}" mode="aspectFill" />
        <view class="meta">
          <view class="name">{{item.name}}</view>
          <role-hot-container chatCount="{{item.messageCount}}" roleHot="{{item.browseCount}}" />
          <view class="desc">{{item.signature || ''}}</view>
        </view>
        <view class="rank-badge {{index < 3 ? 'top3' : ''}}">TOP {{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view>
      </view>
    </view>

    <!-- 宝藏：两列卡片网格 -->
    <view wx:elif="{{activeTab==='wow'}}" class="list-grid">
      <view class="grid-card" wx:for="{{list}}" wx:key="id" bindtap="onRoleClick" data-id="{{item.characterId}}">
        <image class="grid-cover" src="{{item.url}}" mode="aspectFill" />
        <view class="grid-info blur-glass">
          <view class="grid-name">{{item.name}}</view>
          <view class="grid-sub">{{item.signature || ''}}</view>
        </view>
      </view>
    </view>

    <!-- 新崽：全屏海报流 -->
    <view wx:elif="{{activeTab==='new'}}" class="list-poster">
      <view class="poster" wx:for="{{list}}" wx:key="id" bindtap="onRoleClick" data-id="{{item.characterId}}">
        <image class="poster-cover" src="{{item.url}}" mode="widthFix" />
        <view class="poster-info">
          <view class="poster-name">{{item.name}}</view>
          <view class="poster-sub">{{item.signature || ''}}</view>
        </view>
      </view>
    </view>

    <load-more wx:if="{{pageNo > 1}}" status="{{loadMoreStatus}}" list-is-empty="{{listIsEmpty}}" bind:retry="onRetryLoad" />
    <view style="height: {{pageInfo.safeAreaBottom}}px;"></view>
  </scroll-view>

  <t-toast id="t-toast" />
</view>
