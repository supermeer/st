.rank-page{background-color:var(--theme-color-black);min-height:100vh}
.custom-nav{position:sticky;top:0;z-index:10}
.rank-title{color:#fff;font-size:36rpx;font-weight:800}
.rank-header{display:flex;justify-content:space-between;align-items:center;padding:24rpx 64rpx}
.rank-header .header-title {
    font-size: 28px;
    color: #fff;
    font-weight: bold;
    padding-bottom: 12rpx;
}
.rank-header .rank-image {
    width: 160rpx;
    height: 160rpx;
}

.rank-header .date{color:#9aa4b2;font-size:24rpx}
.tabs{display:flex;gap:16rpx;padding:0 24rpx 16rpx}
.tab{padding:12rpx 24rpx;border-radius:999rpx;color:#c7d2fe;background:rgba(99,102,241,.15)}
.tab.active{background:#6366f1;color:#fff}
.content{padding:0 24rpx 100rpx}
/* 热榜样式 */
.list-hot{display:flex;flex-direction:column;gap:16rpx}
.hot-item{display:flex;gap:16rpx;background:linear-gradient(90deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border-radius:16rpx;overflow:hidden;position:relative}
.hot-item .cover{height:160rpx;width:99rpx;border-radius:12rpx;margin:12rpx}
.hot-item .meta{flex:1;display:flex;flex-direction:column;justify-content:center;padding-right:24rpx}
.hot-item .name{color:#fff;font-size:30rpx;font-weight:600}
.hot-item .desc{
    color:#9aa4b2;
    font-size:24rpx;
    margin-top:6rpx;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2; /* 控制行数 */
    overflow: hidden;
    text-overflow: ellipsis;
}
.rank-badge{
    position:absolute;
    right:16rpx;
    top:16rpx;
    background: #aaa;
    color:#3b2e11;
    font-size:22rpx;
    border-radius:8rpx;
    padding:6rpx 10rpx;
}
.top3 {
    background:#f5d0a0;
}
/* 宝藏网格 */
.list-grid{display:flex;flex-wrap:wrap;gap:16rpx}
.grid-card{width:calc(50% - 10rpx);height: calc(81vw - 16rpx); background:rgba(255,255,255,.06);border-radius:16rpx;overflow:hidden;position: relative;}
.grid-cover{width:100%;height:100%;}
.grid-info{padding:12rpx;position: absolute;bottom: 0;left: 0;right: 0;background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 50%, transparent 100%);}
.grid-name{color:#fff;font-size:28rpx;font-weight:600}
.grid-sub{color:#9aa4b2;font-size:22rpx;margin-top:4rpx}
.role-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.role-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #999999;
  border-radius: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}
.increase-box {
  display: flex;
  align-items: center;
  color: var(--success-color);
  font-size: 24rpx;
}

.increase-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}
/* 新崽海报 */
.list-poster{display:flex;flex-direction:column;gap:24rpx}
.poster{position:relative;border-radius:16rpx;overflow:hidden;background:rgba(255,255,255,.04)}
.poster-cover{width:100%}
.poster-info{position:absolute;left:16rpx;bottom:16rpx;color:#fff;text-shadow:0 2rpx 6rpx rgba(0,0,0,.6)}
.poster-name{font-size:32rpx;font-weight:700}
.poster-sub{font-size:24rpx;color:#e5e7eb}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  padding-top: 100rpx;
  --td-loading-color: var(--theme-color-purple);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #999999;
}
