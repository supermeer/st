.feedback-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

/* 固定背景图 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  object-fit: cover;
}

/* 可滚动内容区域 */
.scroll-content {
  position: relative;
  width: 100%;
  height: 100vh;
  z-index: 1;
}
/* 反馈表单 */ 
.feedback-form {
  padding: 32rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  color: #fff;
}

.form-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

/* 文本域 */
.form-textarea {
  min-height: 300rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 12rpx;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  margin-bottom: 32rpx;
  margin-top: 8rpx;
}

/* 分类列表 */
.category-list {
  width: 100%;
}

.category-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.category-item:last-child {
  border-bottom: none;
}

.category-label {
  font-size: 28rpx;
  color: #fff;
  flex: 1;
  padding-right: 24rpx;
  line-height: 1.5;
}

.category-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.category-checkbox.checked {
  background: #4A90E2;
  border-color: #4A90E2;
}

.checkbox-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

/* 提交按钮容器 */
.submit-container {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 10;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  align-items: center;
}

.contact-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.contact-btn::after {
  border: none;
}

.contact-btn:active {
  opacity: 0.7;
}

.submit-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.4);
  border: none;
  transition: all 0.3s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.submit-btn:disabled {
  opacity: 0.6;
}

.submit-btn::after {
  border: none;
}

/* ͼƬ�ϴ����� */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}
.upload-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.upload-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  padding: 8rpx;
}
.upload-add-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  color: var(--yellow-btn-color);
  background: rgba(255, 255, 255, 0.06);
}
.upload-add-text {
  margin-top: 8rpx;
  font-size: 26rpx;
}
