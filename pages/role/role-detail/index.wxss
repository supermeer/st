/* pages/role/role-detail/index.wxss */
page {
  background-color: #000;
}
.role-detail-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 固定背景图 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  object-fit: cover;
}

/* 可滚动内容区域 */
.scroll-content {
  position: relative;
  width: 100%;
  height: 100vh;
  z-index: 1;
}

/* 毛玻璃信息卡片 */
.info-card {
  margin: 100rpx 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  color: #fff;
}

.chat-setting {
  font-size: 24rpx;
  position: relative;
  padding-bottom: 16rpx;
  margin-left: auto;
  color: var(--yellow-btn-color);
  display: flex;
  align-items: center;
}

.chat-setting-icon {
  color: var(--yellow-btn-color);
}

.role-name-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.role-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.role-gender {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.role-gender.male {
  color: #4A9EFF; /* 蓝色 */
}

.role-gender.female {
  color: #FF69B4; /* 粉色 */
}

.role-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  /* padding: 8rpx 20rpx; */
  /* background-color: rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3); */
}

.role-hot-container {
  padding-top: 12rpx;
  text-align: center;
  display: inline-block;
}

/* 详情内容区域 */
.detail-content {
  border-radius: 24rpx;
  margin: 0 32rpx;
  padding: 32rpx;
}

/* 标签页 */
.tabs {
  display: flex;
  gap: 48rpx;
  padding: 16rpx 16rpx 0;
  border-radius: 16rpx;
}

.tab {
  font-size: 32rpx;
  color: #fff;
  position: relative;
  padding-bottom: 16rpx;
}

.tab.active {
  color: var(--magic-color);
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: var(--magic-color);
  border-radius: 2rpx;
}

/* 内容区域 */
.content-section {
  /* padding-top: 16rpx; */
}

.section-content {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.8;
  text-align: justify;
  letter-spacing: 0.8rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  position: relative;
  padding-bottom: 56rpx; /* 给右下角按钮留出空间 */
}

.fold-toggle {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 24rpx;
  color: #ddd;
  padding: 8rpx 16rpx;
}
.section-title-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70rpx;
  font-size: 24rpx;
  padding: 32rpx 0 20rpx;
  /* padding-top: 16rpx; */
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  padding-left: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
}

.section-title .t-icon {
  margin-left: 12rpx;
}
.section-desc {
  font-size: 24rpx;
  margin-left: auto;
}
.section-title-icon {
  color: #fff;
}

.like-blur-glass {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
}

.plot-content {
  font-size: 28rpx;
  color: #fff;
  line-height: 2.5;
  text-align: justify;
  padding: 24rpx;
  border-radius: 16rpx;
}
.setting-block {
  border-radius: 16rpx;
  padding: 24rpx;
}
.setting-row {
  display: flex;
  gap: 24rpx;
}
.setting-item-inline {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0rpx;
}
.setting-item-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.setting-item-value {
  font-size: 28rpx;
  color: #fff;
  margin-top: 8rpx;
}
.setting-identity {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}
.identity-content {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
  position: relative;
}
.fold-toggle-inline {
  font-size: 24rpx;
  color: #ddd;
  margin-left: 12rpx;
}

.style-content {
  font-size: 28rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: justify;
  padding: 32rpx 0rpx 32rpx 24rpx;
  border-radius: 16rpx;
}
.style-right-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.style-right-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}
.style-right-icon {
  color: #fff;
}

.new-story-line {
  color: #bbb;
  font-size: 28rpx;
  margin-top: 40rpx;
  text-align: center;
}
.new-story-btn {
  color: var(--yellow-btn-color);
}

/* 创作者样式 */
.group-role-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.role-content-box {
  margin-left: 12rpx;
  padding-right: 12rpx;
}
.creator-item {
  justify-content: space-between;
}
.creator-item .role-content-box {
  flex: 1;
}
.creator-item .role-content-box .role-name {
  font-size: 28rpx;
  font-weight: normal;
}
.follow-btn-container {
  flex-shrink: 0;
  margin-left: 12rpx;
}
.follow-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--magic-color);
}
.follow-icon {
  margin-right: 8rpx;
}
.follow-btn.unfollowed {
  color: #fff;
}
.follow-btn.followed {
  color: var(--magic-color);
}
.creator-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}
.no-creator-tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
  padding: 20rpx 0;
}

/* 关联群聊列表 */
.group-list {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  gap: 24rpx;
}

.group-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.3s;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
}

.group-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.group-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  z-index: 0;
}

.group-card-bg-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.75) 100%);
}

.group-card > .group-members,
.group-card > .group-info,
.group-card > .group-footer {
  position: relative;
  z-index: 1;
}

.group-card .group-info,
.group-card .group-footer {
  color: #fff;
}

.group-members {
  margin-bottom: 20rpx;
  z-index: 1;
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 120rpx;
  height: 120rpx;
  margin-right: -16rpx;
  display: inline-block;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.member-avatar-img {
  width: 100%;
  height: 100%;
}

.group-info {
  margin-bottom: 16rpx;
}

.group-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.group-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-footer {
  display: flex;
  align-items: center;
}

.group-empty {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
  padding: 60rpx 0;
}