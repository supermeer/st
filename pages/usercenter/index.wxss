/* 群聊列表 */
.group-list {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 0;
  gap: 16rpx;
  max-height: calc(100% - 500rpx);
  overflow-y: auto;
}

.group-card {
  width: calc(33.333% - 12rpx);
  aspect-ratio: 0.618;
  /* 银河深空底色（去掉原本的浅白底） */
  background-color: #06080f;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.3s;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  isolation: isolate;
}

/* 银河流光：底色上的星云光斑 */
.group-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: inherit;
  background:
    radial-gradient(60% 50% at 20% 30%, rgba(96, 130, 200, 0.35) 0%, rgba(96, 130, 200, 0) 70%),
    radial-gradient(50% 45% at 80% 70%, rgba(140, 110, 200, 0.28) 0%, rgba(140, 110, 200, 0) 70%),
    radial-gradient(40% 35% at 60% 20%, rgba(180, 200, 230, 0.22) 0%, rgba(180, 200, 230, 0) 70%);
  filter: blur(50rpx);
  animation: galaxyDrift 18s ease-in-out infinite alternate;
  pointer-events: none;
}

/* 银河流光：缓慢划过的高光带（冷白） */
.group-card::after {
  content: '';
  position: absolute;
  left: -40%;
  top: -20%;
  width: 60%;
  height: 160%;
  z-index: 2;
  border-radius: 50%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(220, 230, 255, 0.08) 35%,
    rgba(255, 255, 255, 0.22) 50%,
    rgba(220, 230, 255, 0.08) 65%,
    rgba(255, 255, 255, 0) 100%
  );
  filter: blur(30rpx);
  transform: rotate(-20deg);
  animation: galaxySweep 12s linear infinite;
  pointer-events: none;
  opacity: 0.55;
}

@keyframes galaxyDrift {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 0.85;
  }
  50% {
    transform: translate3d(4%, -3%, 0) scale(1.06);
    opacity: 1;
  }
  100% {
    transform: translate3d(-3%, 2%, 0) scale(1.02);
    opacity: 0.9;
  }
}

@keyframes galaxySweep {
  0% {
    transform: translate3d(0, 0, 0) rotate(-20deg);
  }
  100% {
    transform: translate3d(220%, 0, 0) rotate(-20deg);
  }
}

.group-card:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.group-card-avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
