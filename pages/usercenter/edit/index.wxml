<view class="profile-edit-page">
  <custom-nav id="editNav" title="" showBack="{{true}}" showHome="{{false}}" transparent="{{true}}" />

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}" style="height: 100vh;">
    <view class="form-content" style="padding-bottom: calc(env(safe-area-inset-bottom) + 100rpx);">
      <!-- 头像 -->
      <view class="form-section blur-glass">
        <view class="form-item">
          <view class="form-label">头像</view>
          <view class="avatar-row" bindtap="onChangeAvatar">
            <image class="avatar-image" src="{{previewAvatar || userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill" />
            <view class="avatar-edit-text">点击更换头像</view>
          </view>
        </view>
      </view>

      <!-- 昵称 -->
      <view class="form-section blur-glass">
        <view class="form-item form-item-row">
          <view class="form-label">
            <text class="label-required">*</text>
            <text>昵称</text>
          </view>
          <input 
            class="form-input form-input-inline" 
            placeholder="请输入昵称" 
            placeholder-class="input-placeholder"
            value="{{nickname}}"
            bindinput="onNicknameInput"
            maxlength="20"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="submit-footer" style="padding-bottom: env(safe-area-inset-bottom);">
    <view class="submit-btn" bindtap="onSave">
      保存
    </view>
  </view>
</view>
