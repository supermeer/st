/* pages/usercenter/edit/index.wxss */
.profile-edit-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.scroll-content { position: relative; width: 100%; z-index: 1; }
.form-content { padding: 32rpx; }

.form-section { margin-bottom: 24rpx; padding: 32rpx; border-radius: 24rpx; color: #fff; }
.blur-glass {
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.form-item { margin-bottom: 32rpx; padding-bottom: 24rpx; }
.form-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.form-item-row { display: flex; align-items: center; justify-content: space-between; }

.form-label { font-size: 28rpx; color: #fff; font-weight: 500; margin-bottom: 8rpx; display: flex; align-items: center; }
.form-item-row .form-label { margin-bottom: 0; flex-shrink: 0; min-width: 120rpx; }
.label-required { color: #ff4d4f; margin-right: 4rpx; font-size: 32rpx; }

.form-input { width: 100%; height: 80rpx; font-size: 28rpx; color: #fff; background: transparent; border: 2rpx solid rgba(255, 255, 255, 0.05); border-radius: 16rpx; padding: 0 24rpx; box-sizing: border-box; }
.form-input-inline { flex: 1; text-align: right; }
.input-placeholder { color: rgba(255, 255, 255, 0.4); }

.avatar-row { display: flex; align-items: center; gap: 20rpx; padding: 12rpx 8rpx; }
.avatar-image { width: 96rpx; height: 96rpx; border-radius: 50%; }
.avatar-edit-text { color: rgba(255, 255, 255, 0.8); font-size: 28rpx; }

.submit-footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; padding: 20rpx 32rpx; background: linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, transparent 100%); }
.submit-btn { width: 100%; height: 96rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 48rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; color: #fff; box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4); }
