<view class="usercenter-page-container">
  <custom-nav
    class="custom-nav"
    show-back="{{false}}"
    show-left-logo="{{false}}"
    show-home="{{false}}"
    transparent="{{true}}"
  >
    <t-image slot="center" src="/static/usercenter/mine_nav.jpg" width="112rpx" height="44rpx" />
  </custom-nav>

  <view class="usercenter-content" style="height: {{contentHeight}}">
    <view class="user-info">
      <view class="user-info-avatar-wrapper" catchtap="goEditProfile">
        <t-image class="user-info-avatar" src="{{userInfo.avatarUrl}}" />
        <view class="user-info-avatar-edit">
          <t-icon name="edit" size="18" color="#fff" />
        </view>
      </view>
      <view class="user-info-name">
        <text catchtap="goEditProfile">{{userInfo.nickname || '小柚子'}}</text>
        <view class="user-info-uid">
          ID：{{userInfo.uid}}
          <view class="id-copy-btn" catchtap="idCopyAction">复制</view></view>
        <view class="user-invite-code">
          <view class="user-invite-code-item" catchtap="onInviteCodeClick">
            <t-image class="user-invite-code-icon" src="/static/usercenter/score.png"/>
            填写邀请码
          </view>
          <view class="user-invite-code-item" catchtap="onInviteClick">
            <t-icon name="share" class="user-invite-code-icon" size="16" />
            邀请好友
          </view>
        </view>
      </view>
      <t-icon class="user-info-arr" name="setting" size="24" color="#fff" bindtap="onUserInfoClick" />
    </view>
    <view class="score-box" bind:tap="onScoreClick">
      <t-image class="score-box-icon" src="/static/vip/score.png" />
      <text class="score-box-text">{{(pointInfo.pointBalance || 0) + (pointInfo.dailyFreeBalance || 0)}}</text>
      <text wx:if="{{!isDev}}" class="score-box-desc">今日赠送{{pointInfo.dailyFreeBalancePreset || 0}}积分已到账</text>
      <t-icon wx:if="{{!isDev}}" class="score-box-arr" name="chevron-right" size="18" />
    </view>
    <view class="vip-box" bind:tap="onVipRenewClick">
      <view class="vip-box-left-content">
        <view class="vip-box-header">
          <t-image wx:if="{{!vipInfo.ifVip}}" class="vip-box-header-icon" src="/static/vip/vip.png"/>
          <text class="vip-box-header-text">{{vipInfo.ifVip ? '星柚会员' : (isDev ? '沉浸式体验' : '开通会员')}}</text>
          <t-button wx:if="{{!vipInfo.ifVip && !isDev}}" class="open-vip-btn" bind:catchtap="onVipRenewClick">立即开通</t-button>
        </view>
        <view wx:if="{{vipInfo.ifVip}}" class="open-vip-btm-line">{{vipInfo.formattedMonthlyExpireTime}}</view>
        <view wx:else class="open-vip-btm-line">无限畅聊 记忆增强 更多灵感回复</view>
      </view>
      <t-image wx:if="{{vipInfo.ifVip}}" class="vip-box-icon" src="/static/vip/vip.png"/>
    </view>
    <view class="star-yao-ji-entry" bind:tap="onStarYaoJiClick">
      <view class="star-yao-ji-entry-left">
        <view class="star-yao-ji-entry-icon-wrapper">
          <view class="star-yao-ji-entry-icon"></view>
        </view>
        <view class="star-yao-ji-entry-text">
          <view class="star-yao-ji-entry-title">星耀集</view>
          <view class="star-yao-ji-entry-desc">我的收益 · 我的战绩</view>
        </view>
      </view>
      <view class="star-yao-ji-entry-right">
        <view class="star-yao-ji-entry-tag">参与</view>
        <t-icon name="chevron-right" size="18" color="#ffd54a" />
      </view>
    </view>
    <view class="content-tabs">
      <view
        class="content-tab {{activeMainTab === 'role' ? 'active' : ''}}"
        bindtap="onMainTabChange"
        data-value="role"
      >
        智能体
        <view class="content-tab-underline" wx:if="{{activeMainTab === 'role'}}"></view>
      </view>
      <view
        class="content-tab {{activeMainTab === 'group' ? 'active' : ''}}"
        bindtap="onMainTabChange"
        data-value="group"
      >
        <text>群聊</text>
        <view class="content-tab-red-dot" wx:if="{{showGroupRedDot}}"></view>
        <view class="content-tab-underline" wx:if="{{activeMainTab === 'group'}}"></view>
      </view>
    </view>

    <block wx:if="{{activeMainTab === 'role'}}">
      <view class="roles-title">
        智能体
        <view class="roles-title-desc">(长按智能体卡片可以发布、编辑等)</view>
      </view>
      <view class="role-type-tabs">
        <view
          class="role-type-tab {{activeRoleType === item.value ? 'active' : ''}}"
          wx:for="{{roleTypeList}}"
          wx:key="value"
          bindtap="onRoleTypeChange"
          data-value="{{item.value}}"
          data-index="{{index}}"
          id="role-tab-{{index}}"
        >
          {{item.name}} {{item.count}}
        </view>
      </view>
      <view class="role-list">
        <view
          class="role-card"
          wx:for="{{roleList}}"
          wx:key="id"
          style="background-image: url('{{item.backgroundImage || item.avatar}}');"
          bind:tap="onRoleClick"
          bind:longpress="onLongPress"
          data-id="{{item.id}}"
        >
          <view wx:if="{{item.publishStatus == 3}}" class="reject-reason-btn" catch:tap="showRejectReason" data-role="{{item}}">查看原因</view>
          <view
            wx:if="{{item._statusBadge && item._statusBadge.text}}"
            class="role-status-ribbon {{item._statusBadge.className}}"
          >
            {{item._statusBadge.text}}
          </view>
          <view class="role-info">
            <view class="role-name-row">
              <text class="role-name">{{item.name}}</text>
            </view>
            <role-hot-container wx:if="{{item.publishStatus && item.publishStatus != 0}}" chatCount="{{item.messageCount}}" roleHot="{{item.browseCount}}" />
          </view>
        </view>
        <view wx:if="{{roleList.length === 0}}" class="role-empty-state">
          <t-icon name="empty" size="64" color="#ccc" />
          <text class="empty-text">参与创作者激励活动，奖励超香！<text class="author-btn" bindtap="onActivityClick">查看活动</text></text>
          <view class="empty-desc" bindtap="createRole"><t-icon class="role-create-btn" name="user-add" size="24" />创建智能体</view>
        </view>
      </view>
    </block>

    <block wx:if="{{activeMainTab === 'group'}}">
      <view class="group-type-tabs">
        <view
          class="group-type-tab {{activeGroupType === item.value ? 'active' : ''}}"
          wx:for="{{groupTypeList}}"
          wx:key="value"
          bindtap="onGroupTypeChange"
          data-value="{{item.value}}"
          data-index="{{index}}"
          id="group-tab-{{index}}"
        >
          {{item.name}} {{item.count}}
        </view>
      </view>
      <view class="group-list">
        <view
          class="group-card"
          wx:for="{{groupList}}"
          wx:key="groupChatId"
          bind:tap="onGroupClick"
          bind:longpress="onGroupLongPress"
          data-id="{{item.groupChatId}}"
          data-groupchatid="{{item.groupChatId}}"
          data-name="{{item.name}}"
        >
          <group-avatar
            class="group-card-avatar"
            urls="{{item.avatarUrls}}"
            fill="{{true}}"
            background-color="rgba(255, 255, 255, 0.16)"
          />
          <view wx:if="{{item.publishStatus == 3}}" class="group-reject-reason-btn" catch:tap="showGroupRejectReason" data-group="{{item}}">查看原因</view>
          <view
            wx:if="{{item._statusBadge && item._statusBadge.text}}"
            class="group-status-ribbon {{item._statusBadge.className}}"
          >
            {{item._statusBadge.text}}
          </view>
          <view class="group-info">
            <view class="group-name-row">
              <text class="group-name">{{item.name}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{groupList.length === 0}}" class="group-empty-state">
          <t-icon name="empty" size="64" color="#ccc" />
          <text class="empty-text">暂无群聊</text>
          <view class="empty-desc" bindtap="onCreateGroup"><t-icon class="role-create-btn" name="user-add" size="24" />创建群聊</view>
        </view>
      </view>
    </block>
  </view>
</view>

<points-recharge-dialog
  id="pointsRechargeDialog"
/>

<invite-code-dialog 
  id="inviteCodeDialog"
  bind:cancel="onInviteCancel"
  bind:confirm="onInviteConfirm"
/>

<recharge-result-dialog 
  id="rechargeResultDialog"
/>

<t-action-sheet
  id="actionSheet"
  usingCustomNavbar
  bind:selected="handleSelected"
/>

<tip-dialog id="tip-dialog" />

<tip-dialog id="reject-dialog">
  <view class="wx-copy-line" slot="btns-top">
    添加客服微信：{{wxCode}}
    <view class="copy-btn" catchtap="copyAction">复制</view>
  </view>
</tip-dialog>

<richtext-dialog
  id="richtextDialog"
  bind:action="richtextAction"
/>

<t-toast id="t-toast" />

<t-dialog id="t-dialog" />

<group-authorize-dialog
  id="authorize-dialog"
  bind:confirm="onAuthorizeConfirm"
  bind:close="onAuthorizeClose"
/>
