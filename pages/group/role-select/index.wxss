/* pages/group/role-select/index.wxss */
page {
  height: 100%;
  background-color: var(--theme-color-black);
}

.role-select-page {
  width: 100%;
  height: 100vh;
  background-color: var(--theme-color-black);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-nav {
  flex-shrink: 0;
}

/* 标签页容器 */
.tabs-container {
  display: flex;
  padding: 0 32rpx;
  background-color: var(--theme-color-black);
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.5);
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #fff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 搜索容器 */
.search-container {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  gap: 16rpx;
  background-color: var(--theme-color-black);
  flex-shrink: 0;
}

.search-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  gap: 12rpx;
}

.search-wrapper.active {
  background: rgba(255, 255, 255, 0.15);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #fff;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 28rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.search-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  height: 72rpx;
}

.search-toggle-text {
  font-size: 28rpx;
  color: #fff;
  white-space: nowrap;
}

/* 筛选标签 */
.filter-tags {
  padding: 0 32rpx 16rpx;
  background-color: var(--theme-color-black);
  flex-shrink: 0;
}

.tags-scroll {
  height: 64rpx;
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #999;
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  white-space: nowrap;
  transition: all 0.3s;
}

.tag-item.active {
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-weight: 500;
}

/* 内容滚动区域 */
.content-scroll {
  flex: 1;
  width: 100%;
  background-color: var(--theme-color-black);
  overflow: hidden;
}

/* 角色列表 */
.role-list {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.role-card {
  width: calc(50% - 8rpx);
  aspect-ratio: 0.618;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: all 0.3s;
}

.role-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.role-card.selected {
  border: 4rpx solid #4A9EFF;
}

/* 选中标记 */
.select-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 角色背景 */
.role-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 角色信息 */
.role-info {
  position: relative;
  z-index: 1;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 50%, transparent 100%);
}

.role-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 8rpx;
}

.role-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.role-tag {
  display: inline-block;
  padding: 4rpx 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.loading-text.retry {
  color: #4A9EFF;
}

/* 底部固定按钮 */
.bottom-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 20rpx 32rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  transition: all 0.3s;
}

.save-btn.has-selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.save-btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}

.save-btn.has-selected .save-btn-text {
  color: #fff;
}

.save-btn-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}
