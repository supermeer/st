<!--pages/group/detail/index.wxml-->
<view class="group-detail-page">
  <!-- 固定背景图 -->
  <image class="page-bg" src="{{showBG ? currentBg : ''}}" mode="aspectFill"></image>
  
  <!-- 固定顶部导航栏 -->
  <custom-nav title="" showBack="{{true}}" showHome="{{false}}" transparent="{{true}}" />
  <!-- 可滚动内容区域 -->
  <scroll-view
    class="scroll-content"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    id="groupDetailScrollView"
    style="height: calc(100% - {{ pageInfo.navHeight + pageInfo.safeAreaBottom}}px)"
  >
    
    <!-- 毛玻璃信息卡片 -->
    <view class="info-card blur-glass">
      <view class="group-name-section">
        <text class="group-name">{{groupInfo.name || '角色名称'}}</text>
        <t-icon wx:if="{{groupInfo.gender === '男'}}" name="gender-male" class="group-gender male" />
        <t-icon wx:elif="{{groupInfo.gender === '女'}}" name="gender-female" class="group-gender female" />
        <view wx:if="{{plotInfo.id}}" class="chat-setting" bind:tap="onDialogSetting">
          对话设定
          <t-icon name="chevron-right-s" class="chat-setting-icon" size="24" />
        </view>
      </view>
      <view class="group-tags">
        <text class="tag" wx:for="{{groupInfo.tags}}" wx:key="index">#{{item.name}}</text>
      </view>
      <view wx:if="{{(groupInfo.publishStatus && groupInfo.publishStatus > 0) || groupInfo.isSystem == 1}}" class="role-hot-container">
        <role-hot-container chatCount="{{groupInfo.messageCount}}" roleHot="{{groupInfo.browseCount}}" />
      </view>
    </view>

    <view class="detail-content blur-glass">
      <!-- 标签页 -->
      <view class="tabs">
        <text class="tab {{currentTab === '1' ? 'active' : ''}}" bind:tap="onTabChange" data-tab="1">关于TA</text>
        <text class="tab {{currentTab === '2' ? 'active' : ''}}" bind:tap="onTabChange" data-tab="2">故事</text>
        <text class="tab {{currentTab === '3' ? 'active' : ''}}" bind:tap="onTabChange" data-tab="3">记忆</text>
      </view>
      
      <!-- 内容区域 -->
      <view wx:if="{{currentTab === '1'}}" class="content-section">
        <view class="section-title-container">
          <view class="section-title">群简介</view>
        </view>
        <view class="section-content like-blur-glass">
          <text>{{descriptionDisplay || groupInfo.description || '暂无描述'}}</text>
          <text wx:if="{{descriptionNeedFold}}" class="fold-toggle" bind:tap="toggleDescription">
            {{descriptionExpanded ? '收起 ▴' : '展开 ▾'}}
          </text>
        </view>
        
        <view class="section-title-container">
          <view class="section-title">群成员</view>
          <!-- <text class="section-desc yellow-btn-text" bind:tap="onSyncVoice">一键同步玩家音色</text> -->
        </view>
        <view class="section-content like-blur-glass">
          <view wx:for="{{groupInfo.characterInfos}}" class="group-role-item" bind:tap="onCharacterInfo" data-item="{{item}}">
            <t-image class="role-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="role-content-box">
              <view class="role-name">{{item.name}}</view>
              <view class="role-tags">
                <text class="role-tag blur-glass" wx:for="{{item.tagNames}}" wx:key="index" wx:for-item="tag">#{{tag}}</text>
              </view>
            </view>
            <text class="section-desc yellow-btn-text">查看设定</text>
            <t-icon name="chevron-right-s" class="section-desc-icon" size="24" />
          </view>
        </view>

        <view class="section-title-container" bind:tap="onChatVoice">
          <view class="section-title">创作者</view>
        </view>
        <view class="section-content like-blur-glass">
          <view class="group-role-item creator-item" wx:if="{{creatorInfo.creatorUserId}}">
            <t-image class="creator-avatar" src="{{creatorInfo.creatorAvatar}}" mode="aspectFill" />
            <view class="role-content-box">
              <view class="role-name">{{creatorInfo.creatorNickname}}</view>
            </view>
            <view wx:if="{{!isOwnCreator}}" class="follow-btn-container">
              <view wx:if="{{isFollowed}}" class="follow-btn followed" bind:tap="onUnfollow">
                <t-icon name="check" size="20" color="var(--magic-color)" class="follow-icon" />
                <text>已关注</text>
              </view>
              <view wx:else class="follow-btn unfollowed" bind:tap="onFollow">
                <t-icon name="user-add" size="20" color="var(--magic-color)" class="follow-icon" />
                <text style="color:var(--magic-color)">关注</text>
              </view>
            </view>
          </view>
          <view wx:else class="no-creator-tip">暂无创作者信息</view>
        </view>
      </view>
      <view wx:if="{{currentTab === '2'}}" class="content-section">
        <view class="section-title-container" bind:tap="onChangeStory">
          <view class="section-title">当前故事</view>
          <t-icon name="chevron-right-s" class="section-title-icon ml-auto" size="24" />
        </view>
        <view class="section-content like-blur-glass">
          <text>
            {{storyInfo.title}}
          </text>
        </view>

        <view class="section-title-container">
          <view class="section-title">故事剧情</view>
        </view>
        <view class="section-content like-blur-glass">
          <text>
            {{storyInfo.scene || '暂无'}}
          </text>
        </view>
        
        <view class="section-title-container">
          <view class="section-title">开场白</view>
        </view>
        <view class="section-content like-blur-glass">
          <view wx:if="{{storyInfo.prologueCharacterId}}" class="group-role-item">
            <t-image class="role-avatar" src="{{plotInfo.prologueCharacterBackgroundImage}}" mode="aspectFill" />
            <view class="role-content-box">
              <view class="role-name">{{plotInfo.prologueCharacterName}}</view>
            </view>
          </view>
          {{storyInfo.prologue || '用户自由开场'}}
        </view>

        <view class="new-story-line" bind:tap="newStoryAction">这个故事没意思？打开脑洞，<text class="new-story-btn">来个新开局！</text></view>
      </view>
      <view wx:if="{{currentTab === '3'}}" class="content-section">
        <view class="section-title-container" bind:tap="onPlotSelect">
          <view class="section-title">当前剧情</view>
          <t-icon name="chevron-right-s" class="section-title-icon" size="24" />
        </view>
        <view class="plot-content like-blur-glass">
          <text>{{ plotInfo.id ? plotInfo.title : '暂无'}}</text>
        </view>
        <view class="section-title-container" bind:tap="onMySetting">
          <view class="section-title">我的设定</view>
          <t-icon wx:if="{{plotInfo.id}}" name="chevron-right-s" class="section-title-icon" size="24" />
        </view>
        <view class="setting-block like-blur-glass">
          <view class="setting-row">
            <view class="setting-item-inline">
              <text class="setting-item-title">我的名称</text>
              <text class="setting-item-value">{{plotInfo.persona.userAddressedAs || '暂无'}}</text>
            </view>
            <view class="setting-item-inline">
              <text class="setting-item-title">性别</text>
              <text class="setting-item-value">{{plotInfo.persona.gender || '暂无'}}</text>
            </view>
          </view>
          <view class="setting-identity">
            <text class="setting-item-title">我是谁</text>
            <view class="identity-content">
              <text>{{identityDisplay || plotInfo.persona.identity || '暂无'}}</text>
              <text wx:if="{{identityNeedFold}}" class="fold-toggle-inline" bind:tap="toggleIdentity">
                {{identityExpanded ? '收起 ▴' : '展开 ▾'}}
              </text>
            </view>
          </view>
        </view>
        <view class="section-title-container" bind:tap="onMemorySetting">
          <view class="section-title">
            智能体记忆力
            <t-icon name="info-circle" size="36rpx" color="#ffffff" catchtap="onMemoryDesc" />
          </view>
          <text class="section-desc yellow-btn-text">记忆加强</text>
          <t-icon name="chevron-right-s" class="section-title-icon" size="24" />
        </view>
        <memory-display 
          currentMemory="{{plotInfo.memoryCount}}"
          memoryOptions="{{memoryOptions}}"
        />
      </view>
    </view>
    
  </scroll-view>
  
  <!-- 记忆力增强弹窗 -->
  <memory-sheet id="memorySheet" />

  <!-- 记忆力说明遮罩层 -->
  <memory-desc-overlay show="{{ showMemoryDescOverlay }}" bind:close="onCloseMemoryDesc" />
</view>
<tip-dialog id="tip-dialog" />

<story-dialog id="story-dialog" />
