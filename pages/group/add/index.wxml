<view class="group-add-page">
  <!-- 固定背景图 -->
  <image class="page-bg" src="{{currentBg}}" mode="aspectFill"></image>
  
  <!-- 固定顶部导航栏 -->
  <custom-nav id="groupAddNav" title="" showBack="{{true}}" showHome="{{false}}" transparent="{{true}}" />

  <!-- 可滚动内容区域 -->
  <scroll-view
    class="scroll-content"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    style="height: calc(100vh - {{ pageInfo.navHeight }}px);"
  >
    <!-- 表单内容 -->
    <view class="form-content" style="padding-bottom: calc({{ pageInfo.safeAreaBottom}}px + 140rpx);">

      <!-- 创建群聊背景按钮 -->
      <view class="bg-button-wrapper" bindtap="onChatBackground">
        <view class="bg-button">
          <t-icon name="star" size="36rpx" color="var(--yellow-btn-color)" />
          <text class="bg-button-text">创建群聊背景</text>
        </view>
      </view>

      <!-- 群设定 -->
      <view class="form-section">
        <view class="section-title">群设定</view>
        
        <!-- 名称 -->
        <view class="form-item form-item-row">
          <view class="form-label">
            <text class="label-required">*</text>
            <text>名称</text>
          </view>
          <input 
            class="form-input form-input-inline" 
            placeholder="请输入" 
            placeholder-class="input-placeholder"
            value="{{formData.name}}"
            data-field="name"
            bindinput="onInputChange"
            maxlength="20"
          />
        </view>

        <!-- 群简介 -->
        <view class="form-item textarea-item">
          <view class="form-label">
            <text class="label-required">*</text>
            <text>群简介</text>
          </view>
          <view class="textarea-counter">{{formData.description.length}}/10000</view>
          <view class="label-placeholder">不影响对话效果，仅用于用户快速了解群聊信息，会对外展示。</view>
          <textarea 
            class="form-textarea" 
            placeholder="如本群是一群帅哥靓女聊天八卦群" 
            placeholder-class="textarea-placeholder"
            value="{{formData.description}}"
            data-field="description"
            bindinput="onTextareaChange"
            maxlength="10000"
            auto-height
          />
        </view>

        <!-- 群成员 -->
        <view class="form-item">
          <view class="form-item-row form-item-header">
            <view class="form-label">
              <text class="label-required">*</text>
              <text>群成员</text>
            </view>
            <text class="member-count">{{selectedCharacters.length}}/9</text>
          </view>
          <view class="members-list">
            <view 
              wx:for="{{selectedCharacters}}" 
              wx:key="id" 
              class="member-item"
            >
              <image 
                wx:if="{{item.avatarUrl}}" 
                src="{{item.avatarUrl}}" 
                mode="aspectFill" 
                class="member-avatar" 
              />
              <view wx:else class="member-avatar member-avatar-placeholder">
                <t-icon name="user" size="40rpx" color="rgba(255,255,255,0.6)" />
              </view>
              <view class="member-delete" data-id="{{item.id}}" bindtap="onRemoveCharacter">
                <t-icon name="close" size="24rpx" color="#fff" />
              </view>
            </view>
            <view class="member-item member-add" bindtap="onAddCharacters">
              <t-icon name="add" size="60rpx" color="#fff" />
            </view>
          </view>
        </view>
      </view>

      <!-- 故事设定 -->
      <view class="form-section">
        <view class="section-title">故事设定</view>
        
        <!-- 故事名称 -->
        <view class="form-item form-item-row">
          <view class="form-label">
            <text class="label-required">*</text>
            <text>故事名称</text>
          </view>
          <input 
            class="form-input form-input-inline" 
            placeholder="请输入" 
            placeholder-class="input-placeholder"
            value="{{formData.plotName}}"
            data-field="plotName"
            bindinput="onInputChange"
            maxlength="50"
          />
        </view>

        <!-- 故事设定 -->
        <view class="form-item textarea-item">
          <view class="form-label">
            <text class="label-required">*</text>
            <text>故事设定</text>
          </view>
          <view class="textarea-counter">{{formData.plotSetting.length}}/10000</view>
          <view class="label-placeholder">决定群聊对话的背景，会对外展示，引起用户的对话兴趣。</view>
          <textarea 
            class="form-textarea" 
            placeholder="如，当前剧情发生在学霸宿舍里，师尊意外穿越成为学霸室友。" 
            placeholder-class="textarea-placeholder"
            value="{{formData.plotSetting}}"
            data-field="plotSetting"
            bindinput="onTextareaChange"
            maxlength="10000"
            auto-height
          />
        </view>

        <!-- 开场白 -->
        <view class="form-item prologue-item">
          <view class="form-label">
            <text>选择开场白角色</text>
          </view>
          
          <!-- 开场白角色选择 -->
          <view class="prologue-characters">
            <!-- 玩家选项 -->
            <view 
              class="prologue-character {{prologueCharacterId === 'player' ? 'selected' : ''}}"
              bindtap="onSelectPrologueCharacter"
              data-id="player"
            >
              <view class="prologue-character-avatar player-avatar">
                <text class="player-text">玩家</text>
              </view>
              <view class="prologue-character-check" wx:if="{{prologueCharacterId === 'player'}}">
                <t-icon name="check-circle-filled" size="28rpx" color="#4A9EFF" />
              </view>
            </view>
            
            <!-- 群成员选项 -->
            <view 
              wx:for="{{selectedCharacters}}" 
              wx:key="id" 
              class="prologue-character {{prologueCharacterId == item.id ? 'selected' : ''}}"
              bindtap="onSelectPrologueCharacter"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
            >
              <image 
                wx:if="{{item.avatarUrl}}" 
                src="{{item.avatarUrl}}" 
                mode="aspectFill" 
                class="prologue-character-avatar" 
              />
              <view wx:else class="prologue-character-avatar member-avatar-placeholder">
                <t-icon name="user" size="40rpx" color="rgba(255,255,255,0.6)" />
              </view>
              <view class="prologue-character-check" wx:if="{{prologueCharacterId == item.id}}">
                <t-icon name="check-circle-filled" size="28rpx" color="#4A9EFF" />
              </view>
            </view>
          </view>
          
          <view class="form-label">
            <text class="label-required">*</text>
            <text>开场白</text>
          </view>
          <view class="label-placeholder">决定智能体对话效果，引起用户的对话兴趣。</view>
          <!-- 开场白内容 -->
          <view class="prologue-content">
            <view class="prologue-text" wx:if="{{formData.prologue}}">{{formData.prologue}}</view>
            <view class="prologue-placeholder" wx:else>请选择开场白角色</view>
          </view>
        </view>
      </view>

      <!-- 高级设定 -->
      <view class="form-section advanced-section">
        <view class="section-title">高级设定</view>
        
        <!-- 对我的设定 -->
        <view class="setting-item" bindtap="onUserSettings">
          <view class="setting-label">对我的设定</view>
          <view class="setting-action">
            <text class="setting-value">{{formData.userAddressedAs ? '修改设置' : '请设置'}}</text>
            <t-icon name="chevron-right" size="40rpx" color="rgba(255,255,255,0.6)" />
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 固定底部提交按钮 -->
  <view class="submit-footer" style="padding-bottom: {{ pageInfo.safeAreaBottom }}px;">
    <view class="submit-btn" bindtap="onSubmit">
      保存设定
    </view>
  </view>

  <!-- 输入弹窗 -->
  <input-sheet id="inputSheet" />
  
  <!-- 背景选择弹窗 -->
  <background-sheet id="backgroundSheet" />
  <image-uploader
    visible="{{showUploader}}"
    isPublic="true"
    bind:success="onUploadSuccess"
    bind:fail="onUploadFail"
    bind:cancel="onUploadCancel"
  />
</view>
<tip-dialog id="tip-dialog" />
