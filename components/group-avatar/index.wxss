.group-avatar {
  box-sizing: border-box;
  display: grid;
  flex-shrink: 0;
  overflow: hidden;
}

.group-avatar__item {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.group-avatar--0,
.group-avatar--1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
}

.group-avatar--2,
.group-avatar--3,
.group-avatar--4 {
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
}

.group-avatar--2 .group-avatar__item:nth-child(1),
.group-avatar--2 .group-avatar__item:nth-child(2) {
  transform: translateY(50%);
}

.group-avatar--3 .group-avatar__item:first-child {
  grid-column: 1 / 3;
  width: calc((100% - var(--avatar-gap, 0rpx)) / 2);
  justify-self: center;
}

.group-avatar--5,
.group-avatar--6,
.group-avatar--7,
.group-avatar--8,
.group-avatar--9 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
}

.group-avatar--5 .group-avatar__item:nth-child(1) {
  grid-column: 1;
  transform: translate(50%, 50%);
}

.group-avatar--5 .group-avatar__item:nth-child(2) {
  grid-column: 2;
  transform: translate(50%, 50%);
}

.group-avatar--6 .group-avatar__item:nth-child(1),
.group-avatar--6 .group-avatar__item:nth-child(2),
.group-avatar--6 .group-avatar__item:nth-child(3) {
  transform: translateY(50%);
}

.group-avatar--7 .group-avatar__item:first-child {
  grid-column: 1 / 4;
  width: calc((100% - 2 * var(--avatar-gap, 0rpx)) / 3);
  justify-self: center;
}

.group-avatar--8 .group-avatar__item:first-child {
  grid-column: 1;
  transform: translateX(50%);
}

.group-avatar--8 .group-avatar__item:nth-child(2) {
  grid-column: 2;
  transform: translateX(50%);
}
