.role-bar {
  width: 100%;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.35);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  padding: 16rpx 0;
}

.role-bar-scroll {
  width: 100%;
  white-space: nowrap;
}

.role-bar-list {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.role-bar-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 12rpx;
  width: 96rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.role-bar-item:active {
  transform: scale(0.92);
}

.role-bar-avatar-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  padding: 4rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.role-bar-item.active .role-bar-avatar-wrapper {
  border-color: var(--theme-color, #ff7a45);
  box-shadow: 0 0 12rpx rgba(255, 122, 69, 0.6);
}

.role-bar-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: #333;
}

.role-bar-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #fff;
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-bar-item.active .role-bar-name {
  color: var(--theme-color, #ff7a45);
  font-weight: bold;
}