/* 遮罩层 */
.create-select-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 9999;
}

/* 弹窗容器 */
.create-select-container {
  width: 100%;
  background: #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  position: relative;
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.close-icon {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
}

/* 标题 */
.create-select-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 48rpx;
  padding-right: 48rpx;
}

/* 选项列表 */
.create-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 选项项 */
.create-option {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
}

.create-option:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.98);
}

.create-option.disabled {
  opacity: 0.5;
}

/* 图标容器 */
.option-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7c5aff 0%, #a78bfa 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
}

.option-icon-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-icon-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

/* 选项信息 */
.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-label-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.option-label {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

/* new 标记 */
.new-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  font-weight: bold;
}

.option-desc {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 箭头 */
.option-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  color: rgba(255, 255, 255, 0.3);
  font-size: 40rpx;
  font-weight: 300;
}
