/* 遮罩层 */
.story-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 弹窗容器 */
.story-dialog-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  z-index: 10001;
  display: flex;
  flex-direction: column;
  max-height: 90vh;
}

.story-dialog-container.show {
  transform: translateY(0);
}

/* 顶部指示条 */
.story-dialog-indicator {
  width: 72rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  margin: 0 auto 16rpx;
  flex-shrink: 0;
}

/* 标题栏 */
.story-dialog-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.story-dialog-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
}

.story-dialog-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 表单内容 */
.story-dialog-body {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-required {
  color: #ff4d4f;
  margin-right: 4rpx;
  font-size: 32rpx;
}

/* 输入框容器 */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.input-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

/* 文本域项 */
.textarea-item {
  position: relative;
}

.textarea-counter-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 12rpx;
}

.textarea-counter {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: auto;
}

.label-placeholder {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  padding-left: 16rpx;
  flex: 1;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea-placeholder {
  color: rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
}

/* 开场白区域 */
.prologue-item {
  margin-bottom: 28rpx;
}

/* 开场白角色选择列表 */
.prologue-characters {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
  margin-bottom: 20rpx;
}

.prologue-character {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.prologue-character.selected {
  border: 4rpx solid #4A9EFF;
}

.prologue-character-avatar {
  width: 100%;
  height: 100%;
}

.member-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* 玩家头像 */
.player-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.player-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

/* 选中标记 */
.prologue-character-check {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
}

/* 开场白内容显示 */
.prologue-content {
  min-height: 180rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.prologue-text {
  font-size: 26rpx;
  color: #fff;
  line-height: 1.6;
  word-break: break-all;
}

.prologue-placeholder {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.3);
  line-height: 1.6;
}

/* 底部按钮 */
.story-dialog-footer {
  flex-shrink: 0;
  padding: 20rpx 0 calc(env(safe-area-inset-bottom) + 20rpx);
}

.story-dialog-submit {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #7c5aff 0%, #a78bfa 50%, #8b5cf6 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(124, 90, 255, 0.4);
}

.story-dialog-submit:active {
  opacity: 0.85;
}