<view class="story-dialog-mask" wx:if="{{visible}}" bindtap="handleMaskClick" catchtouchmove="{{true}}">
  <view class="story-dialog-container {{visible ? 'show' : ''}}" catchtap="{{true}}">
    <!-- 顶部拖动指示条 -->
    <view class="story-dialog-indicator"></view>

    <!-- 标题栏 -->
    <view class="story-dialog-header">
      <view class="story-dialog-title">新建故事</view>
      <view class="story-dialog-close" bindtap="handleClose">
        <t-icon name="close" size="36rpx" color="rgba(255,255,255,0.6)" />
      </view>
    </view>

    <!-- 表单内容 -->
    <scroll-view class="story-dialog-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <!-- 故事名称 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-required">*</text>
          <text>故事名称</text>
        </view>
        <view class="input-wrapper">
          <input
            class="form-input"
            placeholder="请输入"
            placeholder-class="input-placeholder"
            value="{{formData.plotName}}"
            data-field="plotName"
            bindinput="onInputChange"
            maxlength="50"
          />
          <view wx:if="{{formData.plotName}}" class="input-clear" data-field="plotName" bindtap="onClearInput">
            <t-icon name="close-circle-filled" size="32rpx" color="rgba(255,255,255,0.4)" />
          </view>
        </view>
        <view class="textarea-counter-row">
          <view class="label-placeholder">故事名称，便于用户快速了解故事信息</view>
          <view class="textarea-counter">{{formData.plotName.length}}/50</view>
        </view>
      </view>

      <!-- 故事设定 -->
      <view class="form-item textarea-item">
        <view class="form-label">
          <text class="label-required">*</text>
          <text>故事设定</text>
        </view>
        <view class="textarea-counter-row">
          <view class="label-placeholder">决定群聊对话的背景，会对外展示，引起用户的对话兴趣。</view>
          <view class="textarea-counter">{{formData.plotSetting.length}}/10000</view>
        </view>
        <textarea
          class="form-textarea"
          placeholder="如，当前剧情发生在学霸宿舍里，师尊意外穿越成为学霸室友。"
          placeholder-class="textarea-placeholder"
          value="{{formData.plotSetting}}"
          data-field="plotSetting"
          bindinput="onTextareaChange"
          maxlength="10000"
          auto-height
        />
      </view>

      <!-- 开场白 -->
      <view class="form-item prologue-item">
        <view class="form-label">
          <text>选择开场白角色</text>
        </view>

        <!-- 开场白角色选择 -->
        <view class="prologue-characters">
          <!-- 玩家选项 -->
          <view
            class="prologue-character {{formData.prologueCharacterId === 'player' ? 'selected' : ''}}"
            bindtap="onSelectPrologueCharacter"
            data-id="player"
          >
            <view class="prologue-character-avatar player-avatar">
              <text class="player-text">玩家</text>
            </view>
            <view class="prologue-character-check" wx:if="{{formData.prologueCharacterId === 'player'}}">
              <t-icon name="check-circle-filled" size="28rpx" color="#4A9EFF" />
            </view>
          </view>

          <!-- 群成员选项 -->
          <view
            wx:for="{{roles}}"
            wx:key="id"
            class="prologue-character {{formData.prologueCharacterId == item.id ? 'selected' : ''}}"
            bindtap="onSelectPrologueCharacter"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            <t-image
              wx:if="{{item.avatarUrl}}"
              class="prologue-character-avatar"
              src="{{item.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="prologue-character-avatar member-avatar-placeholder">
              <t-icon name="user" size="40rpx" color="rgba(255,255,255,0.6)" />
            </view>
            <view class="prologue-character-check" wx:if="{{formData.prologueCharacterId == item.id}}">
              <t-icon name="check-circle-filled" size="28rpx" color="#4A9EFF" />
            </view>
          </view>
        </view>

        <view class="form-label">
          <text class="label-required">*</text>
          <text>开场白</text>
        </view>
        <view class="label-placeholder">决定智能体对话效果，引起用户的对话兴趣。</view>
        <!-- 开场白内容 -->
        <view class="prologue-content">
          <view class="prologue-text" wx:if="{{formData.prologue}}">{{formData.prologue}}</view>
          <view class="prologue-placeholder" wx:else>请选择开场白角色</view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部保存按钮 -->
    <view class="story-dialog-footer">
      <view class="story-dialog-submit" bindtap="onConfirm">
        <text>保存</text>
      </view>
    </view>
  </view>
</view>