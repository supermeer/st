.autoreply-desc-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 48rpx;
  box-sizing: border-box;
}

.autoreply-desc-content {
  border-radius: 24rpx;
  padding: 40rpx;
  max-width: 600rpx;
}

.autoreply-desc-title {
  color: #fff;
  border-weight: bold;
  font-size: 32rpx;
  width: 100%;
  text-align: center;
  margin-bottom: 24rpx;
}
.autoreply-desc-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.8;
  text-align: justify;
}
.mt {
  margin-top: 24rpx;
}

/* 确认按钮 */
.confirm-btn {
  text-align: center;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  background: linear-gradient(135deg, #7c5aff 0%, #a78bfa 50%, #8b5cf6 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(124, 90, 255, 0.4);
  margin-top: 60rpx;
}
