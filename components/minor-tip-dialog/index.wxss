/* 遮罩层 */
.minor-tip-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

/* 对话框容器 */
.minor-tip-container {
  width: 660rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 4rpx solid #ffaec9;
  padding: 0 32rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部卡通图标 */
.top-icon-wrapper {
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 -32rpx;
  margin-bottom: 8rpx;
}

.top-icon-emoji {
  font-size: 100rpx;
  line-height: 1;
}

/* 标题 */
.minor-tip-title {
  color: #ff3d5c;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

/* 内容卡片 */
.content-card {
  background: #fff5f8;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.card-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.card-text {
  flex: 1;
  color: #3d3d3d;
  font-size: 25rpx;
  line-height: 38rpx;
}

.highlight-text {
  color: #ff3d5c;
  font-weight: bold;
}

/* 协议勾选区域 */
.agreement-section {
  margin-top: 48rpx;
  margin-bottom: 28rpx;
  padding: 0 4rpx;
}

.agreement-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.agreement-item:last-child {
  margin-bottom: 0;
}

.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #cccccc;
  border-radius: 6rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  transition: all 0.2s;
}

.checkbox.checked {
  background: linear-gradient(135deg, #ff85b3 0%, #ff5e9c 100%);
  border-color: #ff5e9c;
}

.check-mark {
  width: 14rpx;
  height: 7rpx;
  border-left: 2rpx solid #ffffff;
  border-bottom: 2rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -3rpx;
}

.agreement-text {
  color: #666666;
  font-size: 23rpx;
  line-height: 32rpx;
  flex: 1;
}

.link {
  color: #ff5e9c;
}

/* 按钮区域 */
.btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.btn-primary {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #ff85b3 0%, #ff5e9c 100%);
  border-radius: 42rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 94, 156, 0.35);
}

.btn-secondary {
  width: 100%;
  height: 84rpx;
  background: #f5f5f5;
  border-radius: 42rpx;
  color: #999999;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}